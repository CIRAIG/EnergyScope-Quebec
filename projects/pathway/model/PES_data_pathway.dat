let t_phase := 	5;#5 years																												

# Reference year : 2020
let diff_2015_phase["2015_2020"] := -2.5;
let diff_2015_phase["2020_2025"] := 2.5;	
let diff_2015_phase["2025_2030"] := 7.5;	
let diff_2015_phase["2030_2035"] := 12.5;
let diff_2015_phase["2035_2040"] := 17.5;	
let diff_2015_phase["2040_2045"] := 22.5;	
let diff_2015_phase["2045_2050"] := 27.5;

# S4 : change values to 10 (safety margin for myopic mode) in order to desactivate the change rate constraints 
#	   May cause problems with myopic mode 
let	limit_LT_renovation	:=	0.3	;#30% of refurbishment per period 
let limit_HT_renovation :=  0.3	;#30% of refurbishment per period 
let limit_elec_renovation := 0.3		;#100% of refurbishment per period 
let	limit_pass_mob_changes	:=	0.5	;#50% of refurbishment per period (5years)
let	limit_freight_changes	:=	0.5 ;#50% of refurbishment per period (5years)

# S5 : Set value to 1 in order to desactivate the change rate constraints.
# Value of 0.166667 correspond to investment cost distributed over the transition
let max_share_cost_phase := 0.18   ; # Max share of the total (non-actualised) transition cost that a 
								  # single phase can represent
								  # Not usable in myopic mode


# Comment to remove the yearly GHG emissions limit (default value = Infinity)
# [ktCO2-eq./year]	
let gwp_limit ["YEAR_2015"]:= Infinity ;
let gwp_limit ["YEAR_2020"]:= Infinity;
let gwp_limit ["YEAR_2025"]:= Infinity;
let gwp_limit ["YEAR_2030"]:= Infinity;
let gwp_limit ["YEAR_2035"]:= 37816;# CO2equ emission of 1990 in Quebec from :
let gwp_limit ["YEAR_2040"]:= 37816;# https://www.environnement.gouv.qc.ca/changements/ges/2022/inventaire-ges-1990-2022.pdf =85.4 Mt of Co2equ. 
let gwp_limit ["YEAR_2045"]:= 37816;# => Gouvernement du Quebec set 37.5 % reduction in CO2equ emissions in 2035 = 53400 kt of Co2equ.
let gwp_limit ["YEAR_2050"]:= 0 ;	# And taking into account that energy sector represents 70,85% of emission of QC : 37816 kt CO2 equ.



