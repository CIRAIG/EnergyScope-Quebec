# Sous-technologies PV/eolien (materials=True): sets
# Derive des technologies agregees de main (PV_ROOF, PV_GROUND, WIND_ONSHORE, NEW_WIND_ONSHORE, WIND_OFFSHORE), cf. Subtechs.mod.
data;
set PV_SUBTECH := PV_ROOF_C_SI PV_ROOF_CDTE PV_ROOF_CIGS PV_ROOF_A_SIGE PV_GROUND_C_SI PV_GROUND_CDTE PV_GROUND_CIGS PV_GROUND_A_SIGE;
set WIND_TECH := WIND_ONSHORE_DD_EESG WIND_ONSHORE_GB_DFIG_SCIG WIND_ONSHORE_DD_PMSG WIND_ONSHORE_GB_PMSG NEW_WIND_ONSHORE_DD_EESG NEW_WIND_ONSHORE_GB_DFIG_SCIG NEW_WIND_ONSHORE_DD_PMSG NEW_WIND_ONSHORE_GB_PMSG WIND_OFFSHORE_DD_EESG WIND_OFFSHORE_GB_DFIG_SCIG WIND_OFFSHORE_DD_PMSG WIND_OFFSHORE_GB_PMSG;
set TECHNOLOGIES_OF_ELECGEN_FAMILIES := WIND_ONSHORE NEW_WIND_ONSHORE WIND_OFFSHORE PV_ROOF PV_GROUND;
set MODELS_OF_TECHNOLOGIES_OF_ELECGEN_FAMILIES["WIND_ONSHORE"] := WIND_ONSHORE_DD_EESG WIND_ONSHORE_GB_DFIG_SCIG WIND_ONSHORE_DD_PMSG WIND_ONSHORE_GB_PMSG;
set MODELS_OF_TECHNOLOGIES_OF_ELECGEN_FAMILIES["NEW_WIND_ONSHORE"] := NEW_WIND_ONSHORE_DD_EESG NEW_WIND_ONSHORE_GB_DFIG_SCIG NEW_WIND_ONSHORE_DD_PMSG NEW_WIND_ONSHORE_GB_PMSG;
set MODELS_OF_TECHNOLOGIES_OF_ELECGEN_FAMILIES["WIND_OFFSHORE"] := WIND_OFFSHORE_DD_EESG WIND_OFFSHORE_GB_DFIG_SCIG WIND_OFFSHORE_DD_PMSG WIND_OFFSHORE_GB_PMSG;
set MODELS_OF_TECHNOLOGIES_OF_ELECGEN_FAMILIES["PV_ROOF"] := PV_ROOF_C_SI PV_ROOF_CDTE PV_ROOF_CIGS PV_ROOF_A_SIGE;
set MODELS_OF_TECHNOLOGIES_OF_ELECGEN_FAMILIES["PV_GROUND"] := PV_GROUND_C_SI PV_GROUND_CDTE PV_GROUND_CIGS PV_GROUND_A_SIGE;
model;
let TECHNOLOGIES_OF_END_USES_TYPE["ELECTRICITY_LV"] := TECHNOLOGIES_OF_END_USES_TYPE["ELECTRICITY_LV"] union PV_SUBTECH;
let TECHNOLOGIES_OF_END_USES_TYPE["ELECTRICITY_MV"] := TECHNOLOGIES_OF_END_USES_TYPE["ELECTRICITY_MV"] union WIND_TECH;
let PV_TECH := PV_TECH union PV_SUBTECH;
