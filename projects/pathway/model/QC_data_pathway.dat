  
# YEAR_2015 has no data file — copy from YEAR_2020 so lifetime/c_inv are correct
for {i in TECHNOLOGIES} {
    let lifetime['YEAR_2015', i] := lifetime['YEAR_2020', i];
    let c_inv['YEAR_2015', i]    := c_inv['YEAR_2020', i];
    let c_maint['YEAR_2015', i]  := c_maint['YEAR_2020', i];
}

