# Configuration des COP
let cop_normal := 3;
let cop_winter := 2;
let cop_peak := 1.15;

# ÉTAPE 1 : Configuration des f_max et f_min (Indexation avec l'année)
let f_max['YEAR_2023', 'DEC_HP_ELEC'] := 10000;
let f_max['YEAR_2023', 'DEC_HP_ELEC_WINTER'] := 10000;
let f_max['YEAR_2023', 'DEC_HP_ELEC_PEAK'] := 10000;

let f_min['YEAR_2023', 'DEC_HP_ELEC'] := 0.0;
let f_min['YEAR_2023', 'DEC_HP_ELEC_WINTER'] := 0.0;
let f_min['YEAR_2023', 'DEC_HP_ELEC_PEAK'] := 0.0;

# ÉTAPE 2 : Configuration des coûts
let c_inv['YEAR_2023', 'DEC_HP_ELEC_WINTER'] := 0.0;
let c_maint['YEAR_2023', 'DEC_HP_ELEC_WINTER'] := 0.0;

let c_inv['YEAR_2023', 'DEC_HP_ELEC_PEAK'] := 0.0;
let c_maint['YEAR_2023', 'DEC_HP_ELEC_PEAK'] := 0.0;

# ÉTAPE 3 : Rendements (COP) (Note : On utilise 3 indices si YEARS est requis par layers_in_out)
let layers_in_out['YEAR_2023', 'DEC_HP_ELEC', 'ELECTRICITY_LV']        := -1 / cop_normal;
let layers_in_out['YEAR_2023', 'DEC_HP_ELEC_WINTER', 'ELECTRICITY_LV'] := -1 / cop_winter;
let layers_in_out['YEAR_2023', 'DEC_HP_ELEC_PEAK', 'ELECTRICITY_LV']   := -1 / cop_peak;

let layers_in_out['YEAR_2023', 'DEC_HP_ELEC_WINTER', 'HEAT_LOW_T_DECEN'] := layers_in_out['YEAR_2023', 'DEC_HP_ELEC', 'HEAT_LOW_T_DECEN'];
let layers_in_out['YEAR_2023', 'DEC_HP_ELEC_PEAK', 'HEAT_LOW_T_DECEN']   := layers_in_out['YEAR_2023', 'DEC_HP_ELEC', 'HEAT_LOW_T_DECEN'];

# Sécurité facteurs de capacité
let {p in PERIODS} c_p_t['YEAR_2023', 'DEC_HP_ELEC_WINTER', p] := 1.0;
let {p in PERIODS} c_p_t['YEAR_2023', 'DEC_HP_ELEC', p]        := 1.0;
let {p in PERIODS} c_p_t['YEAR_2023', 'DEC_HP_ELEC_PEAK', p]   := 1.0;