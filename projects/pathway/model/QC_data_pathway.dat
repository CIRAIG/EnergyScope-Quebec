## Finite f_max for hydro constraint (line 653 — multiplies F_Mult by f_max)
for {y in YEARS} {
	let f_max[y,'NEW_HYDRO_DAM'] := 72.7;
	let f_max[y,'NEW_HYDRO_RIVER'] := 8.1;
	let f_max[y,'HYDRO_STORAGE'] := 10000;
	let f_max[y,'ELEC_STO'] := 100;
	#let f_max[y,'CO2_STO'] := 1000;
	let f_max[y,'H2_STO'] := 1000;
 	let f_max[y,'CEMENT'] :=0;
	let layers_in_out[y,'CO2_E','CO2_E'] := 0 ; # 
}



# CCS
let co2_limit_max := -15000 ;
## We consider "plug-in" CCS technologies instead
for {y in YEARS, f in ENERGY_TECHNOLOGIES_WITH_CC} {
    let f_max[y,f] := 0 ;
}
for {y in YEARS}{
	# Depreciated carbon storage technologies
	#let f_max[y,'EOR'] := 0 ;
	#let f_max[y,'DOGR'] := 0 ;
	#let f_max[y,'UNMINEABLE_COAL_SEAM'] := 0 ;
	#let f_max[y,'DEEP_SALINE'] := 0 ;
	#let f_max[y,'MINES_STORAGE'] := 0 ;
	let f_max[y,'DIRECT_USAGE'] := 0 ;
}


for{y in YEARS}{
	# DHN Share
	let share_heat_dhn_min[y] := 0 ; # 
	let share_heat_dhn_max[y] := 0.5 ; # 
	let reno_max := 0 ; # Remove technology as cost data is too uncertain + no LCA data
	let avail[y,'H2_EHP'] :=  0; # no H2 imports

	# Deactivate IND_HP_ELEC technologies because criticism regarding their ability to reach very high temperatures
	let f_max[y,'IND_HP_ELEC'] := 0 ;

	# Remove losses from transformers (from model calibration)
	let layers_in_out[y,'TRAFO_EH', 'ELECTRICITY_EHV'] := -1.0 ;
	let layers_in_out[y,'TRAFO_EH', 'ELECTRICITY_HV'] := 1.0 ;
	let layers_in_out[y,'TRAFO_HE', 'ELECTRICITY_HV'] := -1.0 ;
	let layers_in_out[y,'TRAFO_HE', 'ELECTRICITY_EHV'] := 1.0 ;
	let layers_in_out[y,'TRAFO_HM', 'ELECTRICITY_HV'] := -1.0 ;
	let layers_in_out[y,'TRAFO_HM', 'ELECTRICITY_MV'] := 1.0 ;
	let layers_in_out[y,'TRAFO_MH', 'ELECTRICITY_MV'] := -1.0 ;
	let layers_in_out[y,'TRAFO_MH', 'ELECTRICITY_HV'] := 1.0 ;
	let layers_in_out[y,'TRAFO_ML', 'ELECTRICITY_MV'] := -1.0 ;
	let layers_in_out[y,'TRAFO_ML', 'ELECTRICITY_LV'] := 1.0 ;
	let layers_in_out[y,'TRAFO_LM', 'ELECTRICITY_LV'] := -1.0 ;
	let layers_in_out[y,'TRAFO_LM', 'ELECTRICITY_MV'] := 1.0 ;

	### TODO: Correct BIOGAS technologies taking wood instead of biogas
	# Meanwhile, force BIOGAS tech to be ignored
	let f_max[y,'BIOGAS_SMR'] := 0;
	let f_max[y,'BIOGAS_SMR_CCS'] := 0;
	let f_max[y,'BIOGAS_ATR'] := 0;
	let f_max[y,'BIOGAS_ATR_CCS'] := 0;

	# No import of biofuels (must be produced internally)
	for {f in BIO_FUELS} {
		let avail[y,f] := 0;
	}

	# No tramways in QC
	let f_max[y,'TRAMWAY'] := 0;

	# When letting the HT_LT option available, the optimizer uses NG + CC + HT_LT to partly fulfill residential heat also, which is unrealistic.
	let f_max[y,'HT_LT'] := 0 ;
	let f_max[y,'HT_LT_DEC'] := 0 ;
	    # Electricity Imports and exports 2021
    let end_uses_demand_year[y,'ELECTRICITY_EHV_EXPORT','EXPORT'] :=	38889;
	let c_maint[y,'ELEC_STO'] := 0.01; 
	let f_max[y,'DHN'] := 0;
	let f_max[y,'DHN_RENOVATION'] := 0;
	let f_max[y,'DOGR'] := 0;
	#let f_max[y,'SNG_PYROLYSIS_PLASMA'] := 0;
	#let f_max[y,'SNG_PYROLYSIS_THERMAL'] := 0;
	let f_max[y,'LT_DEC_WH'] := 0.1;
	let f_max[y,'LT_DHN_WH'] := 0.1;
}