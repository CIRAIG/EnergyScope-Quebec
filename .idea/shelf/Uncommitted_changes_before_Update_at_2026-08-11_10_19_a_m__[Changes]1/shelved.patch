+        col_elec = df_elec.columns[0]
+        row["Électricité"] += df_elec[col_elec].sum()
+
+        records.append(row)
+
+    # Création du DataFrame récapitulatif
+    df_combinee = pd.DataFrame(records).set_index("Scénario")
