+    plt.xlabel("Scénarios", fontsize=10)
+    plt.ylabel(unit_label, fontsize=10)
+    plt.xticks(rotation=0, fontsize=10)
+    plt.grid(axis="y", linestyle="--", alpha=0.4)
+
+    # Légende inversée
+    handles, labels = ax.get_legend_handles_labels()
+    ax.legend(
+        handles[::-1],
